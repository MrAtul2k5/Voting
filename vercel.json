{
  "version": 2,
  "builds": [
    {
      "src": "client-project/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client-project/dist"
      }
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    }
  ],
  "env": {
    "MONGO_URI": "@mongo_uri",
    "JWT_SECRET": "@jwt_secret",
    "CORS_ORIGINS": "https://voting-app-i7h9.vercel.app,https://voting-app-9uaw.vercel.app"
  }
}
